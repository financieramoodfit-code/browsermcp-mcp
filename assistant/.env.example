# Copiá este archivo como `.env` y completá los valores.
# NO subas el archivo .env al repositorio (ya está en .gitignore).

# --- Claude (motor de respuestas) ---
ANTHROPIC_API_KEY=

# Modelo (opcional). Por defecto: claude-opus-5
# MOOD_MODEL=claude-opus-5

# --- Planilla de stock (Google Sheets) ---
# La hoja debe estar compartida como "Cualquiera con el enlace: Lector".
# Estos valores ya apuntan a tu planilla actual; cambialos si usás otra.
MOOD_SHEET_ID=17eSV6YSboUuJHSWa0A4B5Fzn32nYaHUZGk9KZBqbWek
MOOD_SHEET_GID=10888679

# --- Webhook de Meta (Instagram + Facebook) ---
# META_VERIFY_TOKEN: un texto que inventás vos y cargás igual en el panel de Meta.
META_VERIFY_TOKEN=
# META_PAGE_TOKEN: Page Access Token de tu app de Meta (con permisos de mensajería).
META_PAGE_TOKEN=
# Puerto del servidor web (opcional).
PORT=3000
